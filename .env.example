# Supabase transaction pooler (port 6543), role baithak_app
DATABASE_URL=postgresql://baithak_app.<project>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# Step 1 of the gate: Google sign-in. Web-application OAuth client ID from Google Cloud Console.
# No client secret is needed — this uses the ID-token flow.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# Optional: restrict who may even reach the code step. Empty means any Google account.
ALLOWED_EMAILS=

# Step 2 of the gate: the shared codes that decide the role.
ACCESS_CODE=team-code
ADMIN_CODE=admin-code

# Signs the session cookie. 32+ random chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
